<% const editing = !!t.id; const v = (k) => t[k] == null ? '' : t[k]; %>
<div class="page-head"><div><a class="muted" href="<%= editing ? '/app/teachers/' + t.id : '/app/teachers' %>">← Back</a><h1><%= title %></h1></div></div>
<%- include('../../partials/errors') %>
<form method="post" action="<%= editing ? '/app/teachers/' + t.id : '/app/teachers' %>" class="card card-body">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <fieldset><legend>Personal details</legend>
    <div class="form-grid">
      <div class="field"><label for="first_name">First name *</label><input id="first_name" type="text" name="first_name" required value="<%= v('first_name') %>"></div>
      <div class="field"><label for="last_name">Last name *</label><input id="last_name" type="text" name="last_name" required value="<%= v('last_name') %>"></div>
      <div class="field"><label for="gender">Gender</label><select id="gender" name="gender"><option value="">—</option><option <%= v('gender') === 'Male' ? 'selected' : '' %>>Male</option><option <%= v('gender') === 'Female' ? 'selected' : '' %>>Female</option></select></div>
      <div class="field"><label for="phone">Phone</label><input id="phone" type="tel" name="phone" value="<%= v('phone') %>"></div>
      <div class="field"><label for="email">Email</label><input id="email" type="email" name="email" value="<%= v('email') %>"></div>
      <div class="field"><label for="address">Address</label><input id="address" type="text" name="address" value="<%= v('address') %>"></div>
    </div>
  </fieldset>
  <fieldset><legend>Employment</legend>
    <div class="form-grid">
      <div class="field"><label for="staff_no">Staff number *</label><input id="staff_no" type="text" name="staff_no" required value="<%= v('staff_no') %>"></div>
      <div class="field"><label for="hire_date">Hire date</label><input id="hire_date" type="date" name="hire_date" value="<%= v('hire_date') %>"></div>
      <div class="field"><label for="qualification">Qualification</label><input id="qualification" type="text" name="qualification" placeholder="e.g. B.Ed" value="<%= v('qualification') %>"></div>
      <div class="field"><label for="specialization">Specialization</label><input id="specialization" type="text" name="specialization" placeholder="e.g. Mathematics" value="<%= v('specialization') %>"></div>
      <div class="field"><label for="salary">Monthly salary (<%= school.currency %>)</label><input id="salary" type="number" step="0.01" min="0" name="salary" value="<%= v('salary') %>"></div>
      <div class="field"><label for="status">Status</label><select id="status" name="status">
        <% [['active','Active'],['on_leave','On leave'],['inactive','Inactive']].forEach(function (s) { %><option value="<%= s[0] %>" <%= v('status') === s[0] ? 'selected' : '' %>><%= s[1] %></option><% }) %></select></div>
    </div>
  </fieldset>
  <% if (!editing) { %>
  <fieldset><legend>School Unity login</legend>
    <label class="check"><input type="checkbox" name="create_login" value="1" data-reveal="#tlogin" <%= t.create_login ? 'checked' : '' %>> Give this teacher a login (uses the email above) to take attendance and enter marks</label>
    <div id="tlogin" class="form-grid" style="margin-top:12px"><div class="field"><label for="password">Initial password</label><input id="password" type="password" name="password" minlength="8"><div class="hint">Share it with the teacher; they can change it under My account.</div></div></div>
  </fieldset>
  <% } %>
  <div class="actions"><button class="btn btn-primary"><%= editing ? 'Save changes' : 'Add teacher' %></button><a class="btn" href="/app/teachers">Cancel</a></div>
</form>
