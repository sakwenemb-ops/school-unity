<div class="page-head"><div><h1>Plan &amp; billing</h1><p>You're on the <strong><%= school.plan_name %></strong> plan<%= school.trial_ends_at ? ' · trial ends ' + fmtDate(school.trial_ends_at) : '' %>.</p></div></div>
<div class="grid g-2" style="margin-bottom:16px">
  <% [['Active students', usage.students, school.student_limit], ['Teachers', usage.teachers, school.teacher_limit]].forEach(function (u) { const pct = u[2] ? Math.min(100, 100 * u[1] / u[2]) : 0; %>
    <div class="card card-body"><div style="display:flex;justify-content:space-between"><strong><%= u[0] %></strong><span><%= u[1] %> / <%= u[2] == null ? '∞' : u[2] %></span></div>
      <div class="progress" style="margin-top:10px"><span style="width:<%= u[2] == null ? 4 : pct %>%;<%= pct >= 90 ? 'background:var(--bad)' : '' %>"></span></div></div>
  <% }) %>
</div>
<div class="grid g-3">
  <% plans.forEach(function (p) { const current = p.code === school.plan; %>
    <div class="card plan <%= current ? 'featured' : '' %>">
      <% if (current) { %><span class="ribbon">Current plan</span><% } %>
      <h3><%= p.name %></h3><p class="muted" style="margin:0"><%= p.description %></p>
      <div class="price"><%= p.price_monthly ? money(p.price_monthly) : 'Free' %><% if (p.price_monthly) { %> <small class="muted">/ month</small><% } %></div>
      <ul><li><%= p.student_limit == null ? 'Unlimited' : p.student_limit %> students</li><li><%= p.teacher_limit == null ? 'Unlimited' : p.teacher_limit %> teachers</li><li>All modules included</li></ul>
      <% if (!current) { %>
        <form method="post" action="/app/billing" data-confirm="Switch to the <%= p.name %> plan?"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="plan" value="<%= p.code %>">
          <button class="btn btn-block <%= p.price_monthly > school.price_monthly ? 'btn-primary' : '' %>"><%= p.price_monthly > school.price_monthly ? 'Upgrade' : 'Switch' %> to <%= p.name %></button></form>
      <% } else { %><button class="btn btn-block" disabled>Your plan</button><% } %>
    </div>
  <% }) %>
</div>
<p class="muted" style="margin-top:16px">Payment processing is not connected in this build — plan changes take effect immediately. Connect a payment provider (e.g. Stripe) in <code>src/routes/core.js</code> before going live.</p>
