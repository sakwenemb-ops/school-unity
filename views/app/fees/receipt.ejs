<!doctype html>
<html lang="en"><head><%- include('../../partials/head', { title: 'Receipt RCT-' + String(p.id).padStart(6, '0') }) %></head>
<body>
<div class="doc-actions"><a class="btn" href="/app/students/<%= p.student_id %>">← Student</a><a class="btn" href="/app/fees">Fees</a><button class="btn btn-primary" data-print>Print receipt</button></div>
<div class="doc" style="max-width:620px">
  <div class="doc-head">
    <div style="display:flex;gap:12px;align-items:center"><span class="logo"><%= initials(school.name) %></span><div><strong style="font-size:1.1rem"><%= school.name %></strong><br><small class="muted"><%= school.address || '' %> <%= school.phone || '' %></small></div></div>
    <div style="text-align:right"><strong>OFFICIAL RECEIPT</strong><br><code>RCT-<%= String(p.id).padStart(6, '0') %></code></div>
  </div>
  <dl class="kv">
    <dt>Date</dt><dd><%= fmtDate(p.paid_on) %></dd>
    <dt>Received from</dt><dd><%= p.first_name %> <%= p.last_name %> (<%= p.admission_no %>)</dd>
    <dt>Class</dt><dd><%= p.class_name ? p.class_name + ' ' + (p.section || '') : '—' %></dd>
    <dt>Term</dt><dd><%= p.term %> <%= p.academic_year %></dd>
    <dt>Payment method</dt><dd><%= p.method %><%= p.reference ? ' · ' + p.reference : '' %></dd>
    <% if (p.note) { %><dt>Note</dt><dd><%= p.note %></dd><% } %>
  </dl>
  <div style="background:var(--brand-50);border-radius:10px;padding:16px;margin:20px 0;display:flex;justify-content:space-between;align-items:center">
    <span>Amount received</span><strong style="font-size:1.6rem;color:var(--brand)"><%= money(p.amount, school.currency) %></strong></div>
  <dl class="kv"><dt>Term fees</dt><dd><%= money(expected, school.currency) %></dd><dt>Paid to date</dt><dd><%= money(paid, school.currency) %></dd>
    <dt>Balance</dt><dd><b><%= money(balance, school.currency) %></b></dd></dl>
  <p class="muted" style="margin-top:28px;font-size:12px">Received by <%= p.recorded_by_name || '—' %> · Generated by School Unity</p>
</div>
<script src="/js/app.js"></script>
</body></html>
