<div class="page-head">
  <div><h1>Good day, <%= user.name.split(' ')[0] %> 👋</h1><p>Here's what's happening at <%= school.name %> today.</p></div>
  <div class="actions">
    <a class="btn" href="/app/attendance"><svg><use href="#i-check"/></svg>Take attendance</a>
    <a class="btn btn-primary" href="/app/students/new"><svg><use href="#i-plus"/></svg>Admit student</a>
  </div>
</div>

<% const steps = [
  ['classes', 'Create your classes', '/app/classes'], ['subjects', 'Add subjects', '/app/subjects'], ['teachers', 'Add teachers', '/app/teachers/new'],
  ['students', 'Admit or import students', '/app/students/new'], ['fees', 'Set up term fees', '/app/fees']];
   const done = steps.filter(s => onboarding[s[0]]).length; %>
<% if (done < steps.length) { %>
<div class="card" style="margin-bottom:16px">
  <div class="card-head"><h2>Get your school set up</h2><span class="muted"><%= done %> of <%= steps.length %> complete</span></div>
  <ul class="list checklist">
    <% steps.forEach(function (s) { %><li><span class="check-ico <%= onboarding[s[0]] ? 'done' : '' %>">✓</span><a href="<%= s[2] %>"><%= s[1] %></a></li><% }) %>
  </ul>
</div>
<% } %>

<div class="grid g-4" style="margin-bottom:16px">
  <a class="card stat" href="/app/students" style="color:inherit;text-decoration:none"><div class="ico t-indigo"><svg><use href="#i-students"/></svg></div><div><div class="num"><%= stats.students %></div><div class="lbl">Active students<% if (school.student_limit) { %> · limit <%= school.student_limit %><% } %></div></div></a>
  <a class="card stat" href="/app/teachers" style="color:inherit;text-decoration:none"><div class="ico t-teal"><svg><use href="#i-teachers"/></svg></div><div><div class="num"><%= stats.teachers %></div><div class="lbl">Teachers</div></div></a>
  <a class="card stat" href="/app/attendance" style="color:inherit;text-decoration:none"><div class="ico t-amber"><svg><use href="#i-check"/></svg></div><div><div class="num"><%= attToday.total ? Math.round(100 * attToday.present / attToday.total) + '%' : '—' %></div><div class="lbl">Attendance today<%= attToday.total ? ' (' + attToday.total + ' marked)' : '' %></div></div></a>
  <a class="card stat" href="/app/fees" style="color:inherit;text-decoration:none"><div class="ico t-rose"><svg><use href="#i-cash"/></svg></div><div><div class="num"><%= money(collected, school.currency) %></div><div class="lbl">Fees collected · <%= expected ? Math.round(100 * collected / expected) : 0 %>% of <%= money(expected, school.currency) %></div></div></a>
</div>

<div class="grid g-main">
  <div class="stack">
    <div class="card">
      <div class="card-head"><h2>Attendance — last 14 days</h2><a href="/app/attendance/report">Report</a></div>
      <div class="card-body">
        <% if (attTrend.length) { %>
          <div class="vbars">
            <% attTrend.forEach(function (d) { %>
              <div class="vbar" title="<%= d.date %>: <%= d.pct %>%"><small><%= Math.round(d.pct) %>%</small><span class="col" style="height:<%= d.pct %>%"></span><span><%= d.date.slice(8) %></span></div>
            <% }) %>
          </div>
        <% } else { %><div class="empty">No attendance recorded yet.</div><% } %>
      </div>
    </div>
    <div class="grid g-2">
      <div class="card">
        <div class="card-head"><h2>Students per class</h2></div>
        <div class="card-body bars">
          <% const maxC = Math.max(1, ...perClass.map(c => c.n)); perClass.forEach(function (c) { %>
            <div class="bar-row"><span title="<%= c.label %>" style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis"><%= c.label %></span><div class="bar-track"><div class="bar-fill" style="width:<%= (c.n / maxC) * 100 %>%"></div></div><b class="num"><%= c.n %></b></div>
          <% }) %>
          <% if (!perClass.length) { %><div class="empty">No classes yet.</div><% } %>
        </div>
      </div>
      <div class="card">
        <div class="card-head"><h2>Gender balance</h2></div>
        <div class="card-body">
          <% const gTotal = gender.reduce((a, g) => a + g.n, 0) || 1; const colors = { Male: '#6366f1', Female: '#14b8a6', Unspecified: '#cbd5e1' }; %>
          <div class="progress" style="height:16px;display:flex">
            <% gender.forEach(function (g) { %><span style="width:<%= 100 * g.n / gTotal %>%;background:<%= colors[g.g] || '#94a3b8' %>"></span><% }) %>
          </div>
          <div class="donut-legend" style="margin-top:12px">
            <% gender.forEach(function (g) { %><span><i class="dot" style="background:<%= colors[g.g] || '#94a3b8' %>"></i><%= g.g %>: <b><%= g.n %></b> (<%= Math.round(100 * g.n / gTotal) %>%)</span><% }) %>
          </div>
          <hr style="border:0;border-top:1px solid var(--line);margin:16px 0">
          <dl class="kv"><dt>Classes</dt><dd><%= stats.classes %></dd><dt>Subjects</dt><dd><%= stats.subjects %></dd><dt>Plan</dt><dd><%= school.plan_name %></dd></dl>
        </div>
      </div>
    </div>
    <div class="card">
      <div class="card-head"><h2>Recent activity</h2></div>
      <ul class="list">
        <% activity.forEach(function (a) { %><li><%= a.action %><br><small><%= a.user_name || 'System' %> · <%= fmtDate(a.created_at) %></small></li><% }) %>
        <% if (!activity.length) { %><li class="empty">No activity yet.</li><% } %>
      </ul>
    </div>
  </div>
  <div class="stack"><%- include('../partials/side-feed') %></div>
</div>
