<div class="page-head"><div><h1>My account</h1></div></div>
<div class="grid g-2">
  <div class="card card-body"><div class="person"><span class="avatar lg"><%= initials(user.name) %></span><div><h2 style="margin:0"><%= user.name %></h2><p class="muted" style="margin:0"><%= user.email %></p><span class="badge b-brand" style="text-transform:capitalize"><%= user.role %></span> · <%= school.name %></div></div></div>
  <form class="card card-body" method="post" action="/app/account/password"><input type="hidden" name="_csrf" value="<%= csrf %>">
    <h2>Change password</h2>
    <div class="field"><label for="current">Current password</label><input id="current" type="password" name="current" required></div>
    <div class="field"><label for="password">New password</label><input id="password" type="password" name="password" minlength="8" required></div>
    <div class="field"><label for="confirm">Confirm new password</label><input id="confirm" type="password" name="confirm" minlength="8" required></div>
    <button class="btn btn-primary">Update password</button>
  </form>
</div>
