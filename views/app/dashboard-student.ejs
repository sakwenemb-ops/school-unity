<div class="page-head"><div><h1>Hello, <%= student.first_name %>!</h1><p><%= student.class_name ? student.class_name + ' ' + (student.section || '') : 'No class assigned' %> · <%= student.admission_no %></p></div></div>
<div class="grid g-3" style="margin-bottom:16px">
  <a class="card stat" href="/app/me/attendance" style="color:inherit;text-decoration:none"><div class="ico t-teal"><svg><use href="#i-check"/></svg></div><div><div class="num"><%= att.total ? Math.round(100 * att.present / att.total) + '%' : '—' %></div><div class="lbl">Attendance rate</div></div></a>
  <a class="card stat" href="/app/me/results" style="color:inherit;text-decoration:none"><div class="ico t-indigo"><svg><use href="#i-award"/></svg></div><div>
    <% const avg = results.length ? results.reduce((a, r) => a + r.score, 0) / results.length : null; %>
    <div class="num"><%= avg == null ? '—' : avg.toFixed(1) %></div><div class="lbl"><%= latestExam ? latestExam.name + ' average' : 'No results yet' %></div></div></a>
  <a class="card stat" href="/app/me/fees" style="color:inherit;text-decoration:none"><div class="ico t-rose"><svg><use href="#i-cash"/></svg></div><div><div class="num"><%= money(Math.max(0, fees.balance), school.currency) %></div><div class="lbl">Fee balance · <%= school.current_term %></div></div></a>
</div>
<div class="grid g-main">
  <div class="card">
    <div class="card-head"><h2><%= latestExam ? latestExam.name : 'Latest results' %></h2><% if (latestExam) { %><a href="/app/me/results/<%= latestExam.id %>">Report card</a><% } %></div>
    <div class="table-wrap"><table>
      <thead><tr><th>Subject</th><th class="num">Score</th><th>Grade</th></tr></thead>
      <tbody>
        <% results.forEach(function (r) { const g = gradeFor(100 * r.score / latestExam.max_score); %><tr><td><%= r.subject %></td><td class="num"><%= r.score %></td><td><span class="badge b-<%= g %>"><%= g %></span></td></tr><% }) %>
        <% if (!results.length) { %><tr><td colspan="3" class="empty">No results published yet.</td></tr><% } %>
      </tbody></table></div>
  </div>
  <div class="stack"><%- include('../partials/side-feed') %></div>
</div>
