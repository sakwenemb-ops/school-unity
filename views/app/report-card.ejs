<!doctype html>
<html lang="en"><head><%- include('../partials/head', { title: 'Report card — ' + student.first_name + ' ' + student.last_name }) %></head>
<body>
<% const total = grades.reduce((a, g) => a + g.score, 0); const avg = grades.length ? total / grades.length : null; const pct = avg == null ? null : 100 * avg / exam.max_score; const og = gradeFor(pct); %>
<div class="doc-actions"><a class="btn" href="/app" data-back>← Back</a><button class="btn btn-primary" data-print>Print / Save PDF</button></div>
<div class="doc">
  <div class="doc-head">
    <div style="display:flex;gap:14px;align-items:center"><span class="logo" style="width:52px;height:52px;font-size:19px"><%= initials(school.name) %></span>
      <div><h1 style="margin:0"><%= school.name %></h1><small class="muted"><%= school.motto || '' %><%= school.address ? ' · ' + school.address : '' %></small></div></div>
    <div style="text-align:right"><strong>STUDENT REPORT CARD</strong><br><small><%= exam.name %> · <%= exam.term %> <%= exam.academic_year %></small></div>
  </div>
  <dl class="kv" style="grid-template-columns:140px 1fr 140px 1fr;margin-bottom:18px">
    <dt>Student</dt><dd><%= student.first_name %> <%= student.last_name %></dd><dt>Admission no</dt><dd><%= student.admission_no %></dd>
    <dt>Class</dt><dd><%= student.class_name ? student.class_name + ' ' + (student.section || '') : '—' %></dd><dt>Position</dt><dd><%= position ? position + ' of ' + classSize : '—' %></dd>
  </dl>
  <table>
    <thead><tr><th>Subject</th><th class="num">Score (/<%= exam.max_score %>)</th><th class="num">%</th><th>Grade</th><th>Remark</th></tr></thead>
    <tbody>
      <% grades.forEach(function (g) { const p = 100 * g.score / exam.max_score; const gr = gradeFor(p); %>
        <tr><td><%= g.subject %></td><td class="num"><%= g.score %></td><td class="num"><%= p.toFixed(0) %></td><td><span class="badge b-<%= gr %>"><%= gr %></span></td><td><%= g.remark || '' %></td></tr>
      <% }) %>
      <% if (!grades.length) { %><tr><td colspan="5" class="empty">No marks recorded.</td></tr><% } %>
    </tbody>
    <tfoot><tr><th>Total</th><th class="num"><%= total %></th><th class="num"><%= pct == null ? '—' : pct.toFixed(1) %></th><th><span class="badge b-<%= og %>"><%= og %></span></th><th>Mean grade</th></tr></tfoot>
  </table>
  <div class="grid g-2" style="margin-top:22px">
    <div><h3>Attendance</h3><p><%= att.total ? att.present + ' of ' + att.total + ' days present (' + Math.round(100 * att.present / att.total) + '%)' : 'No attendance recorded.' %></p></div>
    <div><h3>Grading scale</h3><p class="muted" style="font-size:13px">A 80–100 · B 70–79 · C 60–69 · D 50–59 · E 40–49 · F below 40</p></div>
  </div>
  <div class="grid g-2" style="margin-top:28px">
    <div><p style="border-top:1px solid var(--ink);padding-top:6px;margin-top:36px">Class teacher's signature</p></div>
    <div><p style="border-top:1px solid var(--ink);padding-top:6px;margin-top:36px">Head teacher's signature &amp; stamp</p></div>
  </div>
  <p class="muted" style="font-size:12px;text-align:center;margin-top:24px">Generated by School Unity on <%= fmtDate(today()) %></p>
</div>
<script src="/js/app.js"></script>
</body></html>
