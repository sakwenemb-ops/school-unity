<!doctype html>
<html lang="en">
<head><%- include('../partials/head') %></head>
<body style="background:#fff">
<%- include('../partials/icons') %>
<nav class="pub-nav">
  <a href="/" class="brand"><span class="logo">SU</span> School Unity</a>
  <div class="links">
    <a href="/#features" class="hide-sm">Features</a>
    <a href="/#pricing" class="hide-sm">Pricing</a>
    <% if (user) { %>
      <a class="btn btn-primary" href="<%= user.role === 'superadmin' ? '/platform' : '/app' %>">Open dashboard</a>
    <% } else { %>
      <a href="/login">Sign in</a>
      <a class="btn btn-primary" href="/signup">Start free</a>
    <% } %>
  </div>
</nav>
<div style="max-width:1200px;margin:0 auto;padding:0 32px"><%- include('../partials/flash') %></div>
<%- body %>
<footer class="pub">© <%= new Date().getFullYear() %> School Unity · One platform for every school</footer>
<script src="/js/app.js"></script>
</body>
</html>
