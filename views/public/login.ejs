<div class="auth-wrap">
  <div class="card auth-card">
    <div class="logo" style="width:46px;height:46px;font-size:17px;margin-bottom:14px">SU</div>
    <h1>Welcome back</h1>
    <p class="muted">Sign in to your School Unity workspace.</p>
    <% if (error) { %><div class="alert alert-error" role="alert"><%= error %></div><% } %>
    <form method="post" action="/login">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="field"><label for="email">Email</label><input id="email" name="email" type="email" required autofocus value="<%= email %>"></div>
      <div class="field"><label for="password">Password</label><input id="password" name="password" type="password" required></div>
      <button class="btn btn-primary btn-block btn-lg">Sign in</button>
    </form>
    <p class="muted" style="text-align:center;margin-top:14px">New school? <a href="/signup">Register for free</a></p>
    <% if (showDemo) { %>
    <div class="demo-box">
      <strong>Demo accounts</strong> (after <code>npm run seed</code>)
      <table>
        <tr><td>Platform owner</td><td>owner@schoolunity.app / owner12345</td></tr>
        <tr><td>School admin</td><td>admin@greenfield.edu / admin12345</td></tr>
        <tr><td>Teacher</td><td>teacher@greenfield.edu / teacher12345</td></tr>
        <tr><td>Student</td><td>student@greenfield.edu / student12345</td></tr>
      </table>
    </div>
    <% } %>
  </div>
</div>
